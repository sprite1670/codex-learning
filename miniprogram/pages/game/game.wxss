page { background:#fff9ed; color:#49382d; }
.page { min-height:100vh; padding:38rpx 30rpx 54rpx; box-sizing:border-box; }
.hero { text-align:center; margin-bottom:28rpx; }.eyebrow { color:#c77639; letter-spacing:7rpx; font-size:20rpx; font-weight:700; }.title { font-size:56rpx; font-weight:800; margin:12rpx 0 8rpx; color:#5a3827; }.subtitle { color:#987b67; font-size:24rpx; }
.status-row { display:flex; gap:14rpx; margin-bottom:22rpx; }.stat { flex:1; background:#fff; border:2rpx solid #f1dfc8; border-radius:20rpx; padding:14rpx 0; text-align:center; box-shadow:0 6rpx 15rpx #bf8f4a12; }.stat-label { display:block; color:#a18b7b; font-size:21rpx; }.stat-value { display:block; margin-top:3rpx; font-size:32rpx; font-weight:700; color:#c26832; }
.board { position:relative; height:760rpx; background:#f8e6c9; border:3rpx solid #efd4ad; border-radius:28rpx; overflow:hidden; box-shadow:inset 0 0 0 8rpx #fbeedb; }.tile { position:absolute; width:124rpx; height:124rpx; border-radius:20rpx; background:linear-gradient(145deg,#fff,#fff8ec); border:3rpx solid #ead6b9; box-shadow:0 8rpx 0 #d9b98d,0 12rpx 20rpx #82542622; display:flex; flex-direction:column; align-items:center; justify-content:center; transition:transform .15s, opacity .15s; }.tile.available:active { transform:translateY(8rpx); box-shadow:0 2rpx 0 #d9b98d; }.tile.covered { filter:brightness(.78) saturate(.65); }.tile-icon { font-size:52rpx; line-height:1.05; }.tile-name { font-size:19rpx; color:#8c6e57; margin-top:6rpx; }.toast { position:absolute; left:50%; top:46%; transform:translate(-50%,-50%); padding:22rpx 38rpx; border-radius:40rpx; background:#5a3827dd; color:white; font-size:30rpx; font-weight:700; white-space:nowrap; }.toast.win { background:#d77b37ee; }.toast.fail { background:#8c4c42ee; }
.tray-title { display:flex; justify-content:space-between; margin:28rpx 4rpx 12rpx; font-size:27rpx; font-weight:700; }.tray-title text { color:#a18b7b; font-weight:400; }.tray { display:flex; gap:8rpx; min-height:96rpx; padding:10rpx; background:#f5dfbd; border-radius:18rpx; }.tray-tile,.tray-empty { flex:1; height:78rpx; min-width:0; border-radius:13rpx; display:flex; align-items:center; justify-content:center; }.tray-tile { background:#fffaf0; border:2rpx solid #e1c9a6; font-size:42rpx; }.tray-empty { border:2rpx dashed #d8b78c; }.restart { margin-top:28rpx; background:#c96836; color:white; border-radius:50rpx; font-size:30rpx; box-shadow:0 7rpx 0 #9d4d2b; }.restart::after { border:0; }.tip { margin:28rpx 18rpx 0; text-align:center; color:#a18b7b; font-size:21rpx; line-height:1.7; }
